{
  "name": "lyrical",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "uqr": "^0.1.3",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.4",
    "wrangler": "^4.155.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "cloudflare": {
    "products": [
      "Workers",
      "KV"
    ],
    "bindings": {
      "KV": {
        "description": "Stores pairing codes and Spotify sessions. Created for you."
      },
      "SPOTIFY_CLIENT_ID": {
        "description": "Client ID of your Spotify app, from the [Spotify developer dashboard](https://developer.spotify.com/dashboard)."
      },
      "SPOTIFY_CLIENT_SECRET": {
        "description": "Client secret of the same Spotify app, under **View client secret** in the created app."
      }
    }
  },
  "overrides": {
    "fflate": "^0.7.5"
  }
}
